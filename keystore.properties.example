# Copia este fichero a keystore.properties (que está gitignored) y rellénalo.
# Alternativa sin fichero: exportar KUSE_STORE_FILE, KUSE_STORE_PASSWORD,
# KUSE_KEY_ALIAS y KUSE_KEY_PASSWORD como variables de entorno.
#
# La keystore vive FUERA del repositorio. Si se pierde, ninguna instalación
# existente de Kuse podrá volver a actualizarse: guárdala con el mismo cuidado
# que las contraseñas.

storeFile=C:/ruta/fuera/del/repo/kuse-release.jks
storePassword=
keyAlias=kuse
keyPassword=
